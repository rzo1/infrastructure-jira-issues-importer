# Apache OpenNLP: migrate the open Jira issues to GitHub issues. Closed issues stay in Jira.
#
#   uv run --env-file examples/opennlp/migration.env fetch_issues.py
#   uv run --env-file examples/opennlp/migration.env fetch_labels.py
#   uv run --env-file examples/opennlp/migration.env main.py
#
# Secrets are NOT stored here: export JIRA_MIGRATION_GITHUB_ACCESS_TOKEN (and for the Jira
# commenter JIRA_MIGRATION_JIRA_TOKEN) in your shell, or enter it when prompted.
# Variables already set in the environment take precedence over this file, e.g. for a dry run:
#   JIRA_MIGRATION_GITHUB_NAME=rzo1 JIRA_MIGRATION_GITHUB_REPO=opennlp-issue-import-test uv run --env-file ...

# Jira
JIRA_MIGRATION_JIRA_URL=https://issues.apache.org/jira
JIRA_MIGRATION_JIRA_PROJECT_NAME=OPENNLP
JIRA_MIGRATION_JQL_QUERY="project = OPENNLP AND resolution = Unresolved ORDER BY key ASC"
JIRA_MIGRATION_JIRA_OUTPUT_DIR=jira_output
JIRA_MIGRATION_FILE_PATHS=jira_output

# GitHub
JIRA_MIGRATION_GITHUB_NAME=apache
JIRA_MIGRATION_GITHUB_REPO=opennlp

# Labels: types, "component: <name>" and Jira labels, mapped onto the labels used in apache/opennlp
JIRA_MIGRATION_COMPONENT_LABEL_PREFIX="component: "
JIRA_MIGRATION_LABELS_MAPPING_FILE=examples/opennlp/labels_mapping.txt
JIRA_MIGRATION_IMPORTED_LABEL=imported-jira-issue

# githubbot mirrors GitHub PR activity into Jira; that already lives on GitHub
JIRA_MIGRATION_SKIP_COMMENT_AUTHORS=githubbot

# Jira commenter (jira_commenter.py)
JIRA_MIGRATION_JIRA_COMMENT_TEMPLATE_FILE=examples/opennlp/jira_comment.txt
